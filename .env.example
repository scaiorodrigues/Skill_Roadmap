# Servidor (Netlify → Environment variables). O app não tem login e não guarda dados de usuários.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=      # secreta: só para o contador diário de uso
GOOGLE_GEMINI_API_KEY=          # secreta: chave do Google AI Studio (começa com "AIza")

# Opcionais
GEMINI_MODEL=gemini-3.8-flash
ANALYSIS_DAILY_LIMIT_PER_IP=3   # análises por visitante por dia
CUSTOM_DAILY_LIMIT_PER_IP=6     # 6º caminho (interesse pessoal) por visitante por dia
ANALYSIS_DAILY_LIMIT_GLOBAL=300 # teto diário do app inteiro (protege o custo da IA)
